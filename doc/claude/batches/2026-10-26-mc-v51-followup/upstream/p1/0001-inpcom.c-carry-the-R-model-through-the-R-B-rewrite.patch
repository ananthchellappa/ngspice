new file mode 100644
index 000000000..65fb8c76f
--- /dev/null
+++ b/tests/regression/temper/temper-res-behav-noise-subckt.sp
@@ -0,0 +1,34 @@
+netlist for temper-res-behav-noise-subckt.cir, sourced from its .control block
+
+* The noise branch of a converted R inside a subcircuit.  Its 1 ohm
+* resistor names the model as the card wrote it, and subcircuit expansion
+* has to translate that name to the subckt's own model (xs:rm), not to the
+* global one of the same name, whose TC and tnom are different on purpose.
+* The local model also comes after the instances that use it, as sky130's do.
+* rg uses the global model at the top level, so that the deck has no unused
+* model for inp_rem_unused_models() to delete before the rewrite: without it
+* the global card is gone, and a lookup that took the wrong scope would find
+* no model at all instead of the wrong one.
+*   a  converted R, local model           b  plain R, the same model
+*   d  converted R, instance dtemp=10     e  plain R, dtemp=10
+* 'r={73k+0*v(x)}' forces the R->B rewrite without changing the value.
+
+.model rm r tc1=-2.47e-3 tc2=2.7e-6 tnom=25
+
+.subckt sr a b d e
+ra a 0 rm r={73k+0*v(a)}
+rb b 0 rm r=73k
+rd d 0 rm r={73k+0*v(d)} dtemp=10
+re e 0 rm r=73k dtemp=10
+.model rm r tc1=4e-3 tc2=-1e-6 tnom=40
+.ends
+
+ia 0 a dc 1u ac 1
+ib 0 b dc 1u ac 1
+id 0 d dc 1u ac 1
+ie 0 e dc 1u ac 1
+xs a b d e sr
+ig 0 g dc 1u
+rg g 0 rm r=73k
+
+.end
diff --git a/tests/regression/temper/temper-res-behav-noise.cir b/tests/regression/temper/temper-res-behav-noise.cir
new file mode 100644
index 000000000..f13098b7e
--- /dev/null
+++ b/tests/regression/temper/temper-res-behav-noise.cir
@@ -0,0 +1,73 @@
+regression test temper-res-behav-noise.cir, R model on the noise branch
+
+* A resistor rewritten into a B source by inp_compat() is noiseless unless
+* 'set enable_noisy_r' is given before the netlist is read (or the
+* instance has noisy=1).  With the switch on, the rewrite adds a noise
+* branch: a 1 ohm resistor whose noise current is scaled into the B source.
+* That 1 ohm resistor has to carry the original card's model and its
+* dtemp/temp, so that the real resistor device applies the TC, the tnom and
+* the noise temperature.  Before, it carried neither, and the converted
+* resistor's thermal noise was flat with temperature and blind to dtemp/temp.
+*
+* The switch is read while the netlist is parsed, so this deck has no
+* netlist of its own: it sources temper-res-behav-noise.sp twice, first
+* with the switch off (a converted R must stay noiseless), then with it on
+* (every converted R must match a plain model R within 1e-9 at 0, 25 and
+* 125 C).  The vectors that span 'reset' live in the const plot.
+* check.sh's filter deletes every line containing 'oise', so the integrated
+* noise values are copied into vectors with other names.
+
+.control
+
+let const.maxerr = 0
+let const.quiet = 1
+
+unset enable_noisy_r
+source $inputdir/temper-res-behav-noise.sp
+noise v(a) ia lin 2 1k 2k
+let const.quiet = onoise_total
+
+set enable_noisy_r
+source $inputdir/temper-res-behav-noise.sp
+
+foreach tk 0 25 125
+  reset
+  set temp=$tk
+  noise v(a) ia lin 2 1k 2k
+  let const.na = onoise_total
+  noise v(b) ib lin 2 1k 2k
+  let const.nb = onoise_total
+  noise v(d) id lin 2 1k 2k
+  let const.nd = onoise_total
+  noise v(e) ie lin 2 1k 2k
+  let const.ne = onoise_total
+  noise v(f) iff lin 2 1k 2k
+  let const.nf = onoise_total
+  noise v(g) ig lin 2 1k 2k
+  let const.ng = onoise_total
+  let ratio = vector(3)
+  let ratio[0] = const.na/const.nb
+  let ratio[1] = const.nd/const.ne
+  let ratio[2] = const.nf/const.ng
+  let err = vecmax(abs(ratio - 1))
+  echo "Note: temp =" $tk "err =" $&err
+  echo "Note: ratio =" $&ratio
+  if err > const.maxerr
+    let const.maxerr = err
+  end
+end
+
+echo "Note: maxerr =" $&const.maxerr "quiet =" $&const.quiet
+
+* success is the tested branch, so a vector that is missing fails the deck
+if const.maxerr <= 1e-9 and const.quiet = 0
+  echo "INFO: success"
+  quit 0
+else
+  echo "ERROR: test failed"
+  quit 1
+end
+
+.endc
+
+.end
