From 1e95f8edc37c3ce80694a4720ffe131bf32df3d1 Mon Sep 17 00:00:00 2001
From: Ananth <ananth.chellappa@outlook.com>
Date: Mon, 26 Oct 2026 09:47:03 -0700
Subject: [PATCH] randnumb.c: warn once when .option seed= overrides setseed

eval_opt() re-seeds the generator from '.option seed=N' (or seed=random)
on every parse, and 'reset' is a parse.  So in the usual Monte Carlo
loop, 'setseed k; reset; op', the option silently beats the setseed just
before it, and every sample draws the same values.  On ngspice-45.2:

    .param rv=agauss(1k,100,1)
    .option seed=5
    r1 1 0 {rv}
    ...
    setseed 1 / reset / op    @r1[r] = 9.312134e+02
    setseed 2 / reset / op    @r1[r] = 9.312134e+02

and nothing is printed.

The option keeps winning; changing that would change long-standing
behaviour.  eval_opt() now calls seed_from_option(), which does exactly
the cp_vset("rndseed") + com_sseed(NULL) pair it did before, and in front
of it prints, once per session and only after an explicit 'setseed N':

    Warning: '.option seed=5' re-seeds the random number generator each time the
        circuit is parsed, by 'source' and by every 'reset', so it overrides 'setseed'.
        Remove the option to let 'setseed' choose the seed.
        (This warning is printed once per session.)

The value is quoted as the deck writes it.  seed=random has its own
wording, which says that each seed it uses is stored in $rndseed.  A bare
'setseed', which re-seeds from $rndseed, does not count.  A deck that
never calls setseed is silent.

eval_opt()'s existing "Multiple 'option seed=val|random' found!" warning
was printed on every parse, once per Monte Carlo sample; it is now
printed once per session by seed_option_multiple().

The flags are cleared by rnd_reset_state(), called from totalreset(), so
a new shared-library session warns again.  The sequence of draws is
unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/frontend/inp.c             |  8 ++--
 src/include/ngspice/randnumb.h |  7 ++++
 src/maths/misc/randnumb.c      | 71 ++++++++++++++++++++++++++++++++++
 src/sharedspice.c              |  1 +
 4 files changed, 82 insertions(+), 5 deletions(-)

diff --git a/src/frontend/inp.c b/src/frontend/inp.c
index f0de1289d..716be037b 100644
--- a/src/frontend/inp.c
+++ b/src/frontend/inp.c
@@ -443,7 +443,7 @@ eval_opt(struct card* deck)
             begtok = &begtok[5]; /*skip seed=*/
         if (begtok) {
             if (has_seed)
-                fprintf(cp_err, "Warning: Multiple 'option seed=val|random' found!\n");
+                seed_option_multiple();
             char* token = gettok(&begtok);
             /* option seed=random [seed='random'] */
             if (eq(token, "random") || eq(token, "{random}")) {
@@ -451,8 +451,7 @@ eval_opt(struct card* deck)
                 gettimeofday(&tv, NULL);
                 /* get random value from current timestamp microseconds */
                 int rseed = (int)(tv.tv_usec);
-                cp_vset("rndseed", CP_NUM, &rseed);
-                com_sseed(NULL);
+                seed_from_option(rseed, TRUE, token);
                 has_seed = TRUE;
             }
             /* option seed=val*/
@@ -461,8 +460,7 @@ eval_opt(struct card* deck)
                 if (sr <= 0)
                     fprintf(cp_err, "Warning: Cannot convert 'option seed=%s' to seed value, skipped!\n", token);
                 else {
-                    cp_vset("rndseed", CP_NUM, &sr);
-                    com_sseed(NULL);
+                    seed_from_option(sr, FALSE, token);
                     has_seed = TRUE;
                 }
             }
diff --git a/src/include/ngspice/randnumb.h b/src/include/ngspice/randnumb.h
index 881175fcf..b458f6d53 100644
--- a/src/include/ngspice/randnumb.h
+++ b/src/include/ngspice/randnumb.h
@@ -1,9 +1,16 @@
 #ifndef ngspice_RANDNUMB_H
 #define ngspice_RANDNUMB_H
 
+#include "ngspice/bool.h"
 #include "ngspice/wordlist.h"
 extern void com_sseed(wordlist *wl);
 extern void setseedinfo(void);
+/* '.option seed=N|random': seed, warning once if 'setseed N' was used;
+   'written' is the option's value as the deck spells it */
+extern void seed_from_option(int seed, bool is_random, const char *written);
+/* more than one '.option seed=': warn, once per session */
+extern void seed_option_multiple(void);
+extern void rnd_reset_state(void);
 
 /* initialize random number generators */
 extern void initw(void);
diff --git a/src/maths/misc/randnumb.c b/src/maths/misc/randnumb.c
index 5308a3b2b..991cf706d 100644
--- a/src/maths/misc/randnumb.c
+++ b/src/maths/misc/randnumb.c
@@ -67,6 +67,19 @@ float  CombLCGTaus2(void);
 void rgauss(double* py1, double* py2);
 static bool seedinfo = FALSE;
 
+/* '.option seed=' versus 'setseed'.  eval_opt() re-seeds from the option on
+   every parse, and 'reset' is a parse, so the option overrides a 'setseed N'
+   made before the reset.  The option keeps winning; seed_from_option() only
+   says so, once per session, and only after an explicit 'setseed N'.  A bare
+   'setseed', which re-seeds from $rndseed, does not set setseed_used.
+   eval_opt()'s warning about more than one '.option seed=' is printed once
+   per session too, by seed_option_multiple(), not on every parse.  The
+   flags are cleared by rnd_reset_state(), called from totalreset() in
+   sharedspice.c, so a new shared-library session warns again. */
+static bool setseed_used = FALSE;
+static bool seed_override_warned = FALSE;
+static bool seed_multiple_warned = FALSE;
+
 
 /* Check if a seed has been set by the command 'set rndseed=value'
    in spinit, .spiceinit or in a .control section
@@ -288,6 +301,8 @@ double exprand(double mean)
 *   take value of variable rndseed as seed
 * command "setseed <n>"
 *   seed with number <n>
+* Only the second form counts as an explicit 'setseed' for the
+* '.option seed=' warning in seed_from_option().
 */
 void
 com_sseed(wordlist *wl)
@@ -315,6 +330,7 @@ com_sseed(wordlist *wl)
         srand((unsigned int)newseed);
         TausSeed();
         cp_vset("rndseed", CP_NUM, &newseed);
+        setseed_used = TRUE;
     }
 
     if (seedinfo)
@@ -327,3 +343,58 @@ setseedinfo(void)
 {
     seedinfo = TRUE;
 }
+
+
+/* Seed from '.option seed=N' or '.option seed=random', for eval_opt().  This
+   is the cp_vset() + com_sseed(NULL) pair eval_opt() has always done, with
+   the warning in front of it.  The warning quotes 'written', the value as
+   the deck spells it, so '.option seed=05' is not shown as 'seed=5'. */
+void
+seed_from_option(int seed, bool is_random, const char *written)
+{
+    if (setseed_used && !seed_override_warned) {
+        if (is_random)
+            fprintf(cp_err,
+                "Warning: '.option seed=%s' re-seeds the random number generator from the clock\n"
+                "    each time the circuit is parsed, by 'source' and by every 'reset', so it\n"
+                "    overrides 'setseed'. Each seed it uses is stored in $rndseed. Remove the\n"
+                "    option to let 'setseed' choose the seed.\n"
+                "    (This warning is printed once per session.)\n",
+                written);
+        else
+            fprintf(cp_err,
+                "Warning: '.option seed=%s' re-seeds the random number generator each time the\n"
+                "    circuit is parsed, by 'source' and by every 'reset', so it overrides 'setseed'.\n"
+                "    Remove the option to let 'setseed' choose the seed.\n"
+                "    (This warning is printed once per session.)\n",
+                written);
+        seed_override_warned = TRUE;
+    }
+    cp_vset("rndseed", CP_NUM, &seed);
+    com_sseed(NULL);
+}
+
+
+/* For eval_opt(): the option deck has more than one 'seed='.  eval_opt()
+   runs on every parse, so this is printed once per session, not once per
+   'reset'. */
+void
+seed_option_multiple(void)
+{
+    if (!seed_multiple_warned) {
+        fprintf(cp_err,
+            "Warning: Multiple 'option seed=val|random' found!\n"
+            "    (This warning is printed once per session.)\n");
+        seed_multiple_warned = TRUE;
+    }
+}
+
+
+/* Forget the setseed and warning flags, for a new session. */
+void
+rnd_reset_state(void)
+{
+    setseed_used = FALSE;
+    seed_override_warned = FALSE;
+    seed_multiple_warned = FALSE;
+}
diff --git a/src/sharedspice.c b/src/sharedspice.c
index 902e50c97..d8fea3175 100644
--- a/src/sharedspice.c
+++ b/src/sharedspice.c
@@ -2577,6 +2577,7 @@ static int totalreset(void)
     cp_remvar("prompt");
 
     destroy_wallace();
+    rnd_reset_state();
 
     rem_controls();
 
