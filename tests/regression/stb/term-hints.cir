* a subcircuit instance
set nbefore = $#plots
set cbefore = $curplot
set mbefore = $stb_marginplot
set sim_status = 0
stb x1 dec 5 1 1e6 >& term-hints.stberr
let const.nerr = 0
let const.nline = 0
set n1 = 1
fopen f1 term-hints.stberr r
while $n1 >= 0
  set ln = "none"
  fread ln $f1 n1
  strcmp p1 "$ln" "Error: stb: probe x1 is a subcircuit instance: name one of its ports, e.g. x1:1"
  if $p1 eq 0
    let const.nerr = const.nerr + 1
  end
  strstr p2 "_$ln" "Error: stb:"
  if $p2 >= 0
    let const.nline = const.nline + 1
  end
end
fclose $f1
strcmp same "$curplot" "$cbefore"
strcmp msame "$stb_marginplot" "$mbefore"
if (const.nerr eq 1) & (const.nline eq 1) & ($sim_status eq 1) & ($#plots eq $nbefore) & ($same eq 0) & ($msame eq 0)
  echo stbchk hints-subcircuit pass
else
  echo stbchk hints-subcircuit fail
end

* a word that looks like an instance of a subcircuit, but there is none
set nbefore = $#plots
set cbefore = $curplot
set mbefore = $stb_marginplot
set sim_status = 0
stb x9 dec 5 1 1e6 >& term-hints.stberr
let const.nerr = 0
let const.nline = 0
set n1 = 1
fopen f1 term-hints.stberr r
while $n1 >= 0
  set ln = "none"
  fread ln $f1 n1
  strcmp p1 "$ln" "Error: stb: probe x9: no such instance in the circuit"
  if $p1 eq 0
    let const.nerr = const.nerr + 1
  end
  strstr p2 "_$ln" "Error: stb:"
  if $p2 >= 0
    let const.nline = const.nline + 1
  end
end
fclose $f1
strcmp same "$curplot" "$cbefore"
strcmp msame "$stb_marginplot" "$mbefore"
if (const.nerr eq 1) & (const.nline eq 1) & ($sim_status eq 1) & ($#plots eq $nbefore) & ($same eq 0) & ($msame eq 0)
  echo stbchk hints-no-such-subcircuit pass
else
  echo stbchk hints-no-such-subcircuit fail
end

* the forms named by the messages are accepted; the port x1:1 is in the
* loop and gives the loop gain of the voltage source probe
set nbefore = $#plots
set sim_status = 0
stb x1:1 dec 5 1 1e6 > term-hints.stblog
let k = 0
let k = (length(loopgain) eq 31) & (vecmax(abs(loopgain + 10/(1 + j(real(frequency)/const.fp)))) < 1e-9)
let const.nadded = $#plots - $nbefore
if k & ($sim_status eq 0) & (const.nadded eq 2)
  echo stbchk hints-port-runs pass
else
  echo stbchk hints-port-runs fail
end
let const.nrun = 0
foreach pr c1:1 m1:2 g1:1
  set sim_status = 0
  set nbefore = $#plots
  stb $pr dec 5 1 1e6 > term-hints.stblog
  let const.nadded = $#plots - $nbefore
  if ($sim_status eq 0) & (const.nadded eq 2)
    let const.nrun = const.nrun + 1
  end
end
if const.nrun eq 3
  echo stbchk hints-named-forms-run pass
else
  echo stbchk hints-named-forms-run fail
end
.endc
.end
