* stb: a command that cannot run says so in one line and makes no plot
*
* Each bad command is run with its messages sent to a file. The file must
* hold a line that starts the report with "Error: stb:" and names the
* probe as it was written; sim_status is 1, no plot was added and the
* current plot is what it was. A good command afterwards runs.
*
* The loop is that of stb-flat.cir: loopgain = -10 / (1 + j f/fp).
vprb x y dc 0
e1 out 0 0 y 10
r1 out x 1k
c1 x 0 1u
.control
let const.fp = 1/(2*pi*1k*1u)
op
set nbefore = $#plots
set cbefore = $curplot

* no source of that name
set sim_status = 0
stb vnothere dec 10 1 1e6 >& stb-fail.stberr
let const.nerr = 0
set n1 = 1
fopen f1 stb-fail.stberr r
while $n1 >= 0
  set ln = "none"
  fread ln $f1 n1
  strstr p1 "_$ln" "Error: stb: probe vnothere: no such instance in the circuit"
  if $p1 >= 0
    let const.nerr = const.nerr + 1
  end
end
fclose $f1
strcmp same "$curplot" "$cbefore"
if (const.nerr eq 1) & ($sim_status eq 1) & ($#plots eq $nbefore) & ($same eq 0)
  echo stbchk fail-no-such-source pass
else
  echo stbchk fail-no-such-source fail
end

* an instance that is not a voltage source
set sim_status = 0
stb r1 dec 10 1 1e6 >& stb-fail.stberr
let const.nerr = 0
set n1 = 1
fopen f1 stb-fail.stberr r
while $n1 >= 0
  set ln = "none"
  fread ln $f1 n1
  strstr p1 "_$ln" "Error: stb: probe r1 is a Resistor, not a voltage source"
  if $p1 >= 0
    let const.nerr = const.nerr + 1
  end
end
fclose $f1
strcmp same "$curplot" "$cbefore"
if (const.nerr eq 1) & ($sim_status eq 1) & ($#plots eq $nbefore) & ($same eq 0)
  echo stbchk fail-not-a-source pass
else
  echo stbchk fail-not-a-source fail
end

setcs up = "VNOTHERE"
* the probe is named as it was written
set sim_status = 0
stb $up dec 10 1 1e6 >& stb-fail.stberr
let const.nerr = 0
set n1 = 1
fopen f1 stb-fail.stberr r
while $n1 >= 0
  set ln = "none"
  fread ln $f1 n1
  strstr p1 "_$ln" "Error: stb: probe VNOTHERE: no such instance in the circuit"
  if $p1 >= 0
    let const.nerr = const.nerr + 1
  end
end
fclose $f1
strcmp same "$curplot" "$cbefore"
if (const.nerr eq 1) & ($sim_status eq 1) & ($#plots eq $nbefore) & ($same eq 0)
  echo stbchk fail-upper-case-name pass
else
  echo stbchk fail-upper-case-name fail
end

