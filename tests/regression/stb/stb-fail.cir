* no probe at all
set sim_status = 0
stb  >& stb-fail.stberr
let const.nerr = 0
set n1 = 1
fopen f1 stb-fail.stberr r
while $n1 >= 0
  set ln = "none"
  fread ln $f1 n1
  strstr p1 "_$ln" "Error: stb: no probe"
  if $p1 >= 0
    let const.nerr = const.nerr + 1
  end
end
fclose $f1
strcmp same "$curplot" "$cbefore"
if (const.nerr eq 1) & ($sim_status eq 1) & ($#plots eq $nbefore) & ($same eq 0)
  echo stbchk fail-no-probe pass
else
  echo stbchk fail-no-probe fail
end

* a good command still runs
stb vprb dec 5 1 1e6 > stb-fail.stblog
strstr pos "$curplot" "stb"
let k = 0
let k = (length(loopgain) eq 31) & (vecmax(abs(loopgain + 10/(1 + j(real(frequency)/const.fp)))) < 1e-9)
if ($pos eq 0) & k & ($sim_status eq 0)
  echo stbchk fail-good-afterwards pass
else
  echo stbchk fail-good-afterwards fail
end
.endc
.end
