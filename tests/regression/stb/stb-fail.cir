* a step that is too small to change the frequency: 0.5 Hz at 1e16 Hz
set sim_status = 0
stb vprb lin 5 1e16 10000000000000002 >& stb-fail.stberr
let const.nerr = 0
set n1 = 1
fopen f1 stb-fail.stberr r
while $n1 >= 0
  set ln = "none"
  fread ln $f1 n1
  strstr p1 "_$ln" "Error: stb: probe vprb: "
  if $p1 >= 0
    let const.nerr = const.nerr + 1
  end
end
fclose $f1
strcmp same "$curplot" "$cbefore"
if (const.nerr eq 1) & ($sim_status eq 1) & ($#plots eq $nbefore) & ($same eq 0)
  echo stbchk fail-step-too-small pass
else
  echo stbchk fail-step-too-small fail
end

