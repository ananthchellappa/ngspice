* a step that is too small to change the frequency: 0.5 Hz at 1e16 Hz
set nbefore = $#plots
set cbefore = $curplot
set mbefore = $stb_marginplot
set sim_status = 0
stb vprb lin 5 1e16 10000000000000002 >& stb-errors.stberr
let const.nerr = 0
let const.nline = 0
set n1 = 1
fopen f1 stb-errors.stberr r
while $n1 >= 0
  set ln = "none"
  fread ln $f1 n1
  strcmp p1 "$ln" "Error: stb: probe vprb: the step of the sweep is too small to change the frequency"
  if $p1 eq 0
    let const.nerr = const.nerr + 1
  end
  strstr p2 "_$ln" "Error: stb:"
  if $p2 >= 0
    let const.nline = const.nline + 1
  end
end
fclose $f1
strcmp same "$curplot" "$cbefore"
strcmp msame "$stb_marginplot" "$mbefore"
if (const.nerr eq 1) & (const.nline eq 1) & ($sim_status eq 1) & ($#plots eq $nbefore) & ($same eq 0) & ($msame eq 0)
  echo stbchk errors-step-too-small pass
else
  echo stbchk errors-step-too-small fail
end

