while $n1 >= 0
  set ln = "none"
  fread ln $f1 n1
  strcmp p1 "$ln" "Error: stb: probe VPRB: the stop frequency 1 is below the start frequency 1e+06"
  if $p1 eq 0
    let const.nerr = const.nerr + 1
  end
  strstr p2 "_$ln" "Error: stb:"
  if $p2 >= 0
    let const.nline = const.nline + 1
  end
end
fclose $f1
strcmp same "$curplot" "$cbefore"
strcmp msame "$stb_marginplot" "$mbefore"
if (const.nerr eq 1) & (const.nline eq 1) & ($sim_status eq 1) & ($#plots eq $nbefore) & ($same eq 0) & ($msame eq 0)
  echo stbchk errors-upper-case-name pass
else
  echo stbchk errors-upper-case-name fail
end

* allowed: a sweep of one point
set nbefore = $#plots
set sim_status = 0
stb vprb dec 10 1k 1k > stb-errors.stblog
let k = 0
let k = (length(loopgain) eq 1) & (abs(real(frequency[0]) - 1k) < 1e-9) & (abs(loopgain[0] + 10/(1 + j(1k/const.fp))) < 1e-9)
let const.nadded = $#plots - $nbefore
if k & ($sim_status eq 0) & (const.nadded eq 2)
  echo stbchk errors-one-point-allowed pass
else
  echo stbchk errors-one-point-allowed fail
end

* allowed: a linear sweep from 0 Hz
set nbefore = $#plots
set sim_status = 0
stb vprb lin 5 0 4k > stb-errors.stblog
let k = 0
let k = (length(loopgain) eq 5) & (real(frequency[0]) eq 0) & (abs(loopgain[0] + 10) < 1e-9) & (vecmax(abs(loopgain + 10/(1 + j(real(frequency)/const.fp)))) < 1e-9)
let const.nadded = $#plots - $nbefore
if k & ($sim_status eq 0) & (const.nadded eq 2)
  echo stbchk errors-lin-from-zero-allowed pass
else
  echo stbchk errors-lin-from-zero-allowed fail
end

* a good command still runs
set nbefore = $#plots
set cbefore = $curplot
set sim_status = 0
stb vprb dec 5 1 1e6 > stb-errors.stblog
strstr pos "$curplot" "stb"
strcmp same "$curplot" "$cbefore"
let k = 0
let k = (length(loopgain) eq 31) & (vecmax(abs(loopgain + 10/(1 + j(real(frequency)/const.fp)))) < 1e-9)
let const.nadded = $#plots - $nbefore
if ($pos eq 0) & ($same ne 0) & k & ($sim_status eq 0) & (const.nadded eq 2)
  echo stbchk errors-good-afterwards pass
else
  echo stbchk errors-good-afterwards fail
end
.endc
.end
