* stb: each bad command gives one line that says what is wrong
*
* Each bad command is run with its messages sent to a file. Exactly one
* line of the file starts with "Error: stb:", and it is, letter for letter,
* the line written here: it names the probe as it was written and says
* which part of the command is wrong. sim_status is 1, no plot was added,
* and the current plot and the variable stb_marginplot are what they were
* before the command; they are taken anew before each one, so that a
* verdict speaks for its own command only. A sweep is checked strictly:
* a number of points below 1, a start frequency that a sweep by decades
* or octaves cannot begin at, a stop frequency of 0 Hz or below the start
* are errors, not defaults.
*
* A sweep of one point and a linear sweep from 0 Hz are allowed, and a
* good command after all the bad ones runs.
*
* Not here: a voltage source with both nodes at ground. The source's own
* setup refuses it ("shorted VSRC") before the analysis starts, so no
* command reaches the line of stb for it.
*
* The loop is that of stb-flat.cir: loopgain = -10 / (1 + j f/fp).
vprb x y dc 0
e1 out 0 0 y 10
r1 out x 1k
c1 x 0 1u
.control
let const.fp = 1/(2*pi*1k*1u)
setcs up = "VPRB"
stb vprb dec 5 1 1e6 > stb-errors.stblog
set cbefore = $curplot
set mbefore = none
if $?stb_marginplot
  set mbefore = $stb_marginplot
end
strstr pos "$cbefore" "stb"
strstr mpos "$mbefore" "stbmargin"
if ($pos eq 0) & ($mpos eq 0)
  echo stbchk errors-good-before pass
else
  echo stbchk errors-good-before fail
end

* no probe at all
set nbefore = $#plots
set cbefore = $curplot
set mbefore = $stb_marginplot
set sim_status = 0
stb  >& stb-errors.stberr
let const.nerr = 0
let const.nline = 0
set n1 = 1
fopen f1 stb-errors.stberr r
while $n1 >= 0
  set ln = "none"
  fread ln $f1 n1
  strcmp p1 "$ln" "Error: stb: no probe given; usage: stb <probe> dec|oct|lin <points> <fstart> <fstop>"
  if $p1 eq 0
    let const.nerr = const.nerr + 1
  end
  strstr p2 "_$ln" "Error: stb:"
  if $p2 >= 0
    let const.nline = const.nline + 1
  end
end
fclose $f1
strcmp same "$curplot" "$cbefore"
strcmp msame "$stb_marginplot" "$mbefore"
if (const.nerr eq 1) & (const.nline eq 1) & ($sim_status eq 1) & ($#plots eq $nbefore) & ($same eq 0) & ($msame eq 0)
  echo stbchk errors-no-probe pass
else
  echo stbchk errors-no-probe fail
end

