end

* no instance of that name (guard: this line is not new)
set nbefore = $#plots
set cbefore = $curplot
set mbefore = $stb_marginplot
set sim_status = 0
stb vnothere dec 10 1 1e6 >& stb-errors.stberr
let const.nerr = 0
let const.nline = 0
set n1 = 1
fopen f1 stb-errors.stberr r
while $n1 >= 0
  set ln = "none"
  fread ln $f1 n1
  strcmp p1 "$ln" "Error: stb: probe vnothere: no such instance in the circuit"
  if $p1 eq 0
    let const.nerr = const.nerr + 1
  end
  strstr p2 "_$ln" "Error: stb:"
  if $p2 >= 0
    let const.nline = const.nline + 1
  end
end
fclose $f1
strcmp same "$curplot" "$cbefore"
strcmp msame "$stb_marginplot" "$mbefore"
if (const.nerr eq 1) & (const.nline eq 1) & ($sim_status eq 1) & ($#plots eq $nbefore) & ($same eq 0) & ($msame eq 0)
  echo stbchk errors-no-such-source pass
else
  echo stbchk errors-no-such-source fail
end

* an instance that is not a voltage source: the line names the terminal
* form (see term-hints.cir)
set nbefore = $#plots
set cbefore = $curplot
set mbefore = $stb_marginplot
set sim_status = 0
stb r1 dec 10 1 1e6 >& stb-errors.stberr
let const.nerr = 0
let const.nline = 0
set n1 = 1
fopen f1 stb-errors.stberr r
while $n1 >= 0
  set ln = "none"
  fread ln $f1 n1
  strcmp p1 "$ln" "Error: stb: probe r1 is a Resistor, not a voltage source: to break the loop at one of its terminals write r1:1"
  if $p1 eq 0
    let const.nerr = const.nerr + 1
  end
  strstr p2 "_$ln" "Error: stb:"
  if $p2 >= 0
    let const.nline = const.nline + 1
  end
end
fclose $f1
strcmp same "$curplot" "$cbefore"
strcmp msame "$stb_marginplot" "$mbefore"
if (const.nerr eq 1) & (const.nline eq 1) & ($sim_status eq 1) & ($#plots eq $nbefore) & ($same eq 0) & ($msame eq 0)
  echo stbchk errors-not-a-source pass
else
  echo stbchk errors-not-a-source fail
end

* the probe is named as it was written
set nbefore = $#plots
set cbefore = $curplot
