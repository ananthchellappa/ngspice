* 7. a loop gain that is not finite
stb vnan dec 5 1 1e6 > stb-margin-cases.stblog
set sp = $curplot
let const.nline = 0
let const.nw1 = 0
set n1 = 1
fopen f1 stb-margin-cases.stblog r
while $n1 >= 0
  set ln = "none"
  fread ln $f1 n1
  strstr p1 "_$ln" "_stb: "
  if $p1 eq 0
    let const.nline = const.nline + 1
  end
  strstr p1 "_$ln" "_stb: warning: the loop gain is not finite at 1 Hz (31 point(s))"
  if $p1 eq 0
    let const.nw1 = const.nw1 + 1
  end
end
fclose $f1
set mp = none
if $?stb_marginplot
  set mp = $stb_marginplot
end
strcmp same "$mp" "$mprev"
set mprev = $mp
setplot $mp
let k = 0
let k = (length(phasemarginfreq) eq 1) & (length(phasemargin) eq 1) & (length(gainmarginfreq) eq 1) & (length(gainmargin) eq 1)
let m = 0
let m = ((phasemarginfreq eq phasemarginfreq) eq 0) & ((phasemargin eq phasemargin) eq 0) & ((gainmarginfreq eq gainmarginfreq) eq 0) & ((gainmargin eq gainmargin) eq 0)
if (const.nline eq 2) & (const.nw1 eq 1) & k & m & ($same ne 0)
  echo stbchk cases-not-finite pass
else
  echo stbchk cases-not-finite fail
end
* the loop-gain plot is there, with NaN at every point
setplot $sp
let k = 0
let k = (length(loopgain) eq 31) & (vecmax((real(loopgain) eq real(loopgain)) + (imag(loopgain) eq imag(loopgain))) eq 0)
if k
  echo stbchk cases-not-finite-curve pass
else
  echo stbchk cases-not-finite-curve fail
end

