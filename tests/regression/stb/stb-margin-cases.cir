* the loop gain is zero there and nowhere else
setplot $sp
let k = 0
let k = (length(loopgain) eq 5) & (real(frequency[2]) eq 100) & (abs(loopgain[2]) eq 0) & (abs(loopgain[0]) > 0.1) & (abs(loopgain[1]) > 0.1) & (abs(loopgain[3]) > 0.1) & (abs(loopgain[4]) > 0.1)
if k
  echo stbchk cases-zero-at-one-point-curve pass
else
  echo stbchk cases-zero-at-one-point-curve fail
end

* the lines as they are printed
stb vpos dec 5 1 1e6
stb vbp dec 20 0.01 1e9
stb vtc dec 500 1k 1e7
stb vnl dec 5 1 1e6
stb vprb dec 5 1 100
stb vprb oct 3 1 100
stb vprb lin 11 0 1k
stb vprb dec 5 1k 1k
stb vlo dec 5 1 1e6
stb vnan dec 5 1 1e6
stb vz lin 5 50 150
.endc
.end
