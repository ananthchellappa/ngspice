* the spellings of the deck still run
set sp0 = $curplot
stb Vtop dec 2 1 1e4 localgnd=Lg > stb-near-miss-case.stblog
strcmp same "$curplot" "$sp0"
if $same ne 0
  echo stbchk near-miss-exact-source-runs pass
else
  echo stbchk near-miss-exact-source-runs fail
end

set sp0 = $curplot
stb X1:In dec 2 1 1e4 > stb-near-miss-case.stblog
strcmp same "$curplot" "$sp0"
if $same ne 0
  echo stbchk near-miss-exact-terminal-runs pass
else
  echo stbchk near-miss-exact-terminal-runs fail
end
.endc
.end
